{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "title": "Regime do Producer (ground truth)",
      "id": 1,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "SEM DRIFT", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "DRIFT GRADUAL", "color": "orange" } } },
            { "type": "value", "options": { "2": { "text": "DRIFT ABRUPTO", "color": "red" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 1 },
            { "color": "red", "value": 2 }
          ] }
        }
      },
      "targets": [
        { "expr": "finbank_producer_regime", "refId": "A", "legendFormat": "Regime" }
      ]
    },
    {
      "type": "stat",
      "title": "Features com Drift",
      "id": 2,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background", "graphMode": "area",
        "textMode": "value_and_name", "orientation": "auto"
      },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 3 }
      ] } } },
      "targets": [
        { "expr": "finbank_features_with_drift", "refId": "A", "legendFormat": "drift" }
      ]
    },
    {
      "type": "stat",
      "title": "PSI Máximo (>0.25 = severo)",
      "id": 3,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background", "graphMode": "area",
        "textMode": "value_and_name", "orientation": "auto"
      },
      "fieldConfig": { "defaults": {
        "unit": "none", "decimals": 3,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "orange", "value": 0.10 },
          { "color": "red", "value": 0.25 }
        ] }
      } },
      "targets": [
        { "expr": "finbank_max_psi", "refId": "A", "legendFormat": "max PSI" }
      ]
    },
    {
      "type": "stat",
      "title": "Transações Consumidas",
      "id": 4,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value", "graphMode": "area", "textMode": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [
        { "color": "blue", "value": null }
      ] } } },
      "targets": [
        { "expr": "finbank_transactions_consumed_total", "refId": "A", "legendFormat": "consumidas" }
      ]
    },

    {
      "type": "timeseries",
      "title": "PSI por Feature vs Thresholds",
      "id": 10,
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none", "min": 0,
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green",  "value": null },
            { "color": "orange", "value": 0.10 },
            { "color": "red",    "value": 0.25 }
          ] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "PSI crítico" }, "properties": [
            { "id": "custom.lineStyle", "value": { "fill": "dash" } },
            { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
          ] },
          { "matcher": { "id": "byName", "options": "PSI warning" }, "properties": [
            { "id": "custom.lineStyle", "value": { "fill": "dash" } },
            { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
          ] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "targets": [
        { "expr": "finbank_drift_psi", "refId": "A", "legendFormat": "{{feature}}" },
        { "expr": "finbank_psi_threshold", "refId": "B", "legendFormat": "PSI crítico" },
        { "expr": "finbank_psi_warning", "refId": "C", "legendFormat": "PSI warning" }
      ]
    },
    {
      "type": "timeseries",
      "title": "p-valor K–S por Feature (< alpha => drift)",
      "id": 11,
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none", "min": 0, "max": 1,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "alpha" }, "properties": [
            { "id": "custom.lineStyle", "value": { "fill": "dash" } },
            { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
          ] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "min", "lastNotNull"] } },
      "targets": [
        { "expr": "finbank_drift_ks_pvalue", "refId": "A", "legendFormat": "{{feature}}" },
        { "expr": "finbank_ks_alpha", "refId": "B", "legendFormat": "alpha" }
      ]
    },

    {
      "type": "timeseries",
      "title": "Distância de Wasserstein por Feature",
      "id": 20,
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {
        "unit": "none", "min": 0,
        "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
      } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "targets": [
        { "expr": "finbank_drift_wasserstein", "refId": "A", "legendFormat": "{{feature}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "PSI Médio & Fração de Features com Drift",
      "id": 21,
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none", "min": 0,
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 15 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Fração c/ drift" }, "properties": [
            { "id": "unit", "value": "percentunit" }
          ] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "targets": [
        { "expr": "finbank_mean_psi", "refId": "A", "legendFormat": "PSI médio" },
        { "expr": "finbank_max_psi", "refId": "B", "legendFormat": "PSI máximo" },
        { "expr": "finbank_drift_fraction", "refId": "C", "legendFormat": "Fração c/ drift" }
      ]
    },

    {
      "type": "heatmap",
      "title": "Drift Detectado por Feature (1=drift, 0=ok)",
      "id": 30,
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "finbank_drift_detected", "refId": "A", "legendFormat": "{{feature}}", "format": "time_series" }
      ],
      "options": {
        "calculate": false,
        "cellGap": 2,
        "color": { "mode": "scheme", "scheme": "RdYlGn", "reverse": true, "steps": 4, "min": 0, "max": 1 },
        "yAxis": { "axisLabel": "feature" },
        "showValue": "auto"
      }
    },

    {
      "type": "timeseries",
      "title": "Taxa de Fraude na Janela",
      "id": 40,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {
        "unit": "percentunit", "min": 0,
        "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15 }
      } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "targets": [
        { "expr": "finbank_window_fraud_rate", "refId": "A", "legendFormat": "taxa de fraude" }
      ]
    },
    {
      "type": "bargauge",
      "title": "Alertas de Drift por Feature (acumulado)",
      "id": 41,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": { "defaults": {
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green",  "value": null },
          { "color": "orange", "value": 1 },
          { "color": "red",    "value": 25 }
        ] }
      } },
      "targets": [
        { "expr": "finbank_drift_alerts_total", "refId": "A", "legendFormat": "{{feature}}" }
      ]
    },

    {
      "type": "timeseries",
      "title": "Throughput de Ingestão (transações/s) & Janela",
      "id": 50,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 39 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Janela (transações)" }, "properties": [
            { "id": "custom.axisPlacement", "value": "right" }
          ] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] } },
      "targets": [
        { "expr": "rate(finbank_transactions_consumed_total[1m])", "refId": "A", "legendFormat": "ingestão (txn/s)" },
        { "expr": "finbank_window_size", "refId": "B", "legendFormat": "Janela (transações)" }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["aula7", "drift", "streaming", "kappa", "finbank"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Aula 7 — FinBank Drift Streaming (Kappa)",
  "uid": "aula7-drift-streaming",
  "version": 1,
  "weekStart": ""
}
